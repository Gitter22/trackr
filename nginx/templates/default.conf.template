# Trcker gateway. Routes by Host:
#   ${APP_DOMAIN}            -> marketing (SPA)
#   admin.${APP_DOMAIN}      -> control panel (SPA + /api/admin)
#   <slug>.${APP_DOMAIN}     -> tenant app, only if the tenant is active
#   anything else            -> 404
# X-Tenant-Slug is always set here from the Host; a client-sent value never reaches the API.

upstream api { server api:4000; }
upstream web { server web:80; }

# Root domain: marketing
server {
  listen 80;
  server_name ${APP_DOMAIN};
  set $tenant_slug "";
  location /api/ { include conf.d/proxy_headers.inc; proxy_pass http://api; }
  location / { include conf.d/proxy_headers.inc; proxy_pass http://web; }
}

# Control panel
server {
  listen 80;
  server_name admin.${APP_DOMAIN};
  set $tenant_slug "";
  location /api/ { include conf.d/proxy_headers.inc; proxy_pass http://api; }
  location /graphql { return 404; }
  location / { include conf.d/proxy_headers.inc; proxy_pass http://web; }
}

# Tenants
server {
  listen 80;
  server_name ~^(?<tenant>[a-z0-9-]+)\.${APP_DOMAIN_RE}$;
  set $tenant_slug $tenant;

  location = /_tenant_check {
    internal;
    include conf.d/proxy_headers.inc;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_pass http://api/api/internal/tenant-check;
  }

  location /api/ { include conf.d/proxy_headers.inc; proxy_pass http://api; }
  location /graphql { include conf.d/proxy_headers.inc; proxy_pass http://api; }

  # Static assets are shared by every host, no tenant check needed.
  location /assets/ { include conf.d/proxy_headers.inc; proxy_pass http://web; }
  location = /favicon.svg { include conf.d/proxy_headers.inc; proxy_pass http://web; }

  # Pages: only for active tenants. Unknown or inactive -> 404 page.
  location / {
    auth_request /_tenant_check;
    error_page 401 403 =404 @not_found;
    include conf.d/proxy_headers.inc;
    proxy_pass http://web;
  }

  location @not_found {
    rewrite ^ /tenant-not-found.html break;
    include conf.d/proxy_headers.inc;
    proxy_pass http://web;
  }
}

# Unknown hosts
server {
  listen 80 default_server;
  return 404;
}
