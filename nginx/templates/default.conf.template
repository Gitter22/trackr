# Trcker gateway. Routes by Host:
#   ${APP_DOMAIN}            -> marketing (SPA)
#   admin.${APP_DOMAIN}      -> control panel (SPA + /api/admin)
#   <slug>.${APP_DOMAIN}     -> tenant app, only if the tenant is active
#   anything else            -> 404
# The client's X-Tenant-Slug is always overwritten here (proxy_set_header replaces it).

upstream api { server api:4000; }
upstream web { server web:80; }

proxy_http_version 1.1;
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Proxy-Secret "${PROXY_SECRET}";

# Root domain: marketing
server {
  listen 80;
  server_name ${APP_DOMAIN};
  location /api/ { proxy_set_header X-Tenant-Slug ""; proxy_pass http://api; }
  location / { proxy_pass http://web; }
}

# Control panel
server {
  listen 80;
  server_name admin.${APP_DOMAIN};
  location /api/ { proxy_set_header X-Tenant-Slug ""; proxy_pass http://api; }
  location /graphql { return 404; }
  location / { proxy_pass http://web; }
}

# Tenants
server {
  listen 80;
  server_name ~^(?<tenant>[a-z0-9-]+)\.${APP_DOMAIN_RE}$;

  location = /_tenant_check {
    internal;
    proxy_pass http://api/api/internal/tenant-check;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header X-Tenant-Slug $tenant;
  }

  location /api/ { proxy_set_header X-Tenant-Slug $tenant; proxy_pass http://api; }
  location /graphql { proxy_set_header X-Tenant-Slug $tenant; proxy_pass http://api; }

  # Static assets are shared by every host, no tenant check needed.
  location /assets/ { proxy_pass http://web; }

  # Pages: only for active tenants. Unknown or inactive -> 404 page.
  location / {
    auth_request /_tenant_check;
    error_page 401 403 =404 @not_found;
    proxy_pass http://web;
  }

  location @not_found {
    rewrite ^ /tenant-not-found.html break;
    proxy_pass http://web;
  }
}

# Unknown hosts
server {
  listen 80 default_server;
  return 404;
}
