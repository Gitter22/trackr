{
  "name": "@trcker/api",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && cp -r src/graphql/schema dist/graphql/ && cp -r src/generated dist/",
    "start": "node dist/server.js",
    "migrate:tenants": "tsx src/scripts/migrate-tenants.ts",
    "validate:graphql": "tsx src/scripts/validate-graphql.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "codegen": "graphql-codegen --config codegen.ts"
  },
  "dependencies": {
    "@graphql-tools/load-files": "8.0.9",
    "@graphql-tools/merge": "10.0.9",
    "@graphql-tools/schema": "11.0.9",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "dataloader": "2.2.3",
    "express": "5.3.0",
    "graphql": "16.15.0",
    "graphql-yoga": "6.1.0",
    "ioredis": "5.11.1",
    "jsonwebtoken": "9.0.3",
    "lru-cache": "11.5.3",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "8.0.0",
    "@graphql-codegen/typescript": "7.0.1",
    "@graphql-codegen/typescript-resolvers": "7.0.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^24.0.0",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.2",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
